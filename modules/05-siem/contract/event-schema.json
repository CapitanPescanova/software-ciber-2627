{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIEM Sprint 1 security event candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "timestamp",
    "source",
    "event_type",
    "severity",
    "title",
    "description",
    "details"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique within source; stable on retries. UUID is not required."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Original detection time in UTC."
    },
    "source": {
      "type": "string",
      "enum": [
        "ids",
        "honeypot",
        "scanner"
      ]
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "description": "Shared catalog pending; existing examples retained."
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object",
      "additionalProperties": true,
      "description": "Producer-specific data; internal validation pending agreement."
    }
  }
}
